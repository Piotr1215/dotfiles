#!/usr/bin/env bash
set -eo pipefail

# Refuse a push that rewinds or deletes main or master on the remote.
# In the homelab repo Argo CD applies whatever main holds, so a force push
# from a stale base drops the commits that landed since and reverts them live,
# with no commit explaining it. A deliberate rewrite: git push --no-verify.
#
# git passes the remote name in $1 and one line per ref on stdin:
#   <local ref> <local oid> <remote ref> <remote oid>

remote=${1:-remote}
refused=0

while read -r _ local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/main | refs/heads/master) ;;
        *) continue ;;
    esac
    branch=${remote_ref#refs/heads/}

    if [[ "$local_oid" =~ ^0+$ ]]; then
        echo "pre-push: refusing to delete $branch on $remote" >&2
        refused=1
    elif [[ "$remote_oid" =~ ^0+$ ]]; then
        continue
    # Exits 1 when the remote tip is not an ancestor and 128 when it is not even
    # in the local repo; either way the push would drop commits on the remote.
    elif ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
        echo "pre-push: refusing to rewind $branch on $remote: its tip ${remote_oid:0:12} is not in what you are pushing" >&2
        refused=1
    fi
done

if [[ "$refused" -eq 1 ]]; then
    echo "Rebase onto it instead: git pull --rebase $remote <branch>" >&2
    echo "A deliberate rewrite: git push --no-verify" >&2
    exit 1
fi
