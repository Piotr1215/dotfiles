diff --git a/src/app.rs b/src/app.rs
index 28da6e8..9e8a730 100644
--- a/src/app.rs
+++ b/src/app.rs
@@ -62,6 +62,175 @@ use crate::{
 
 const MAX_LINE: usize = 4096;
 
+// Write commands whose output is discarded run with footnotes off. The project
+// footnote alone makes taskwarrior load every task in the database to compute
+// project completion, about 0.7s per action on a 45k-task database.
+const QUIET: &str = "rc.verbose=nothing";
+
+// Write commands that can touch several tasks, run without asking.
+const NO_PROMPTS: [&str; 5] = [
+  "rc.bulk=0",
+  "rc.confirmation=off",
+  "rc.dependency.confirmation=off",
+  "rc.recurrence.confirmation=off",
+  QUIET,
+];
+
+// A taskwarrior write or report export can take seconds on a large database,
+// more while other processes use it. The UI loop hands both to one background
+// thread instead of waiting, and that thread runs them in the order queued, so
+// an export always sees every write queued before it.
+enum Job {
+  Write(Box<TaskWrite>),
+  Export { cmd: std::process::Command },
+}
+
+// The row to select once a write has run, read from its output.
+#[derive(Clone, Copy)]
+enum Select {
+  Nothing,
+  UndoneTask,
+  CreatedTask,
+}
+
+struct TaskWrite {
+  label: &'static str,
+  report_errors: bool,
+  select: Select,
+  cmd: std::process::Command,
+  // Runs when `cmd` named a task by an id that no longer belongs to it.
+  retry: Option<std::process::Command>,
+}
+
+impl TaskWrite {
+  fn new(label: &'static str, report_errors: bool, select: Select, (cmd, retry): (std::process::Command, Option<std::process::Command>)) -> Self {
+    Self {
+      label,
+      report_errors,
+      select,
+      cmd,
+      retry,
+    }
+  }
+
+  fn run(&mut self) -> io::Result<std::process::Output> {
+    let output = self.cmd.output();
+    // A filter that matches no task exits 1 and, with footnotes off, prints
+    // nothing.
+    let missed = matches!(&output, Ok(o) if o.status.code() == Some(1) && o.stdout.is_empty() && o.stderr.is_empty());
+    match self.retry.as_mut() {
+      Some(retry) if missed => retry.output(),
+      _ => output,
+    }
+  }
+}
+
+// `seq` is the queue position of the job that produced the result.
+enum JobResult {
+  Write {
+    label: &'static str,
+    report_errors: bool,
+    select: Select,
+    output: io::Result<std::process::Output>,
+  },
+  Export {
+    seq: u64,
+    desc: String,
+    output: io::Result<std::process::Output>,
+  },
+}
+
+struct Worker {
+  jobs: mpsc::Sender<(u64, Job)>,
+  results: tokio::sync::mpsc::UnboundedReceiver<JobResult>,
+}
+
+impl Worker {
+  fn spawn() -> Self {
+    let (jobs, queue) = mpsc::channel::<(u64, Job)>();
+    let (tx, results) = tokio::sync::mpsc::unbounded_channel();
+    std::thread::spawn(move || {
+      for (seq, job) in queue {
+        let result = match job {
+          Job::Write(mut write) => JobResult::Write {
+            output: write.run(),
+            label: write.label,
+            report_errors: write.report_errors,
+            select: write.select,
+          },
+          Job::Export { mut cmd } => JobResult::Export {
+            seq,
+            desc: format!("{:?}", cmd),
+            output: cmd.output(),
+          },
+        };
+        if tx.send(result).is_err() {
+          break;
+        }
+      }
+    });
+    Self { jobs, results }
+  }
+}
+
+// Clears the screen and resets the back buffer, so the next draw repaints every
+// cell. terminal.clear() would do the same, but it first queries the cursor
+// position, and that query times out while the event stream is reading stdin:
+// after a resize, and after a shortcut, edit or shell command hands the
+// terminal back.
+fn repaint_all<B: Backend>(terminal: &mut Terminal<B>) -> Result<(), B::Error> {
+  let size = terminal.size()?;
+  terminal.resize(Rect::new(0, 0, size.width, size.height))
+}
+
+enum Step {
+  Event(Event<KeyCode>),
+  Job(JobResult),
+  Hangup,
+}
+
+// Closing the terminal sends SIGHUP to the TUI's process group, which would
+// drop writes still queued. The TUI catches it, and SIGTERM, to run them
+// before it exits; queue_write starts each write in its own process group so
+// one already running is not killed with the TUI's.
+#[cfg(unix)]
+struct Hangup {
+  hangup: tokio::signal::unix::Signal,
+  terminate: tokio::signal::unix::Signal,
+}
+
+#[cfg(unix)]
+impl Hangup {
+  fn new() -> io::Result<Self> {
+    use tokio::signal::unix::{SignalKind, signal};
+    Ok(Self {
+      hangup: signal(SignalKind::hangup())?,
+      terminate: signal(SignalKind::terminate())?,
+    })
+  }
+
+  async fn recv(&mut self) {
+    tokio::select! {
+      _ = self.hangup.recv() => {},
+      _ = self.terminate.recv() => {},
+    }
+  }
+}
+
+#[cfg(not(unix))]
+struct Hangup;
+
+#[cfg(not(unix))]
+impl Hangup {
+  fn new() -> io::Result<Self> {
+    Ok(Self)
+  }
+
+  async fn recv(&mut self) {
+    std::future::pending::<()>().await
+  }
+}
