.envrc
.claude-wt
tmp/

# AI coding tools. LLM config (CLAUDE.md, AGENTS.md, .claude/, .gp.md,
# .aider.conf.yml) is a versioned artifact and is never ignored here; only
# chat history and caches are.
.aider.chat.history.md
.aider.input.history
.aider.tags.cache*/

# Secrets
.keys/
.aws/

# Generated/cache
ai-theater/
.config/cmus/

# Claude Code keeps machine-local settings here, and they can hold tokens.
**/.claude/settings.local.json

# Python bytecode
__pycache__/
*.pyc
