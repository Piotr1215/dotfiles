#!/usr/bin/zsh

prompt_instructions="CORE PRINCIPLES:
• 80% READING/RESEARCH, 20% WRITING - understand deeply before coding
• Read SOURCE CODE to understand WHY, not just HOW
• Every line of code must FIGHT for its right to exist
• Minimize code - less is better, none is best
• NEVER add features not asked for - solve ONLY the stated problem
• Research docs AND source code before writing anything
• Test isolated commands before integrating
• Code without tests is incomplete
• No assumptions - find root causes, ask if unclear
• Break tasks into subtasks, use todo lists
• Only commit when explicitly asked

Keep your responses concise and actionable. When providing commands or code:
- Show one solution at a time
- Use triple backticks with language scope
- No explanations unless asked
- For errors, provide the fix directly

User request below:"

# Function to execute command and open Claude Code with Ctrl+G
function execute_and_claude() {
    # Get the current command from the buffer
    local cmd="$BUFFER"
    local current_path=$(pwd)

    # Clear the buffer
    BUFFER=""

    # Execute the command and capture its output (strip ANSI codes)
    local output=$(eval "$cmd" 2>&1 | sed -r "s/\x1b\[[0-9;]*[mGKHl]//g")

    # Create temporary file with command and output
    local tmpfile=$(mktemp /tmp/claude_buffer.XXXXXX)

    echo "$prompt_instructions" > $tmpfile
    echo "" >> $tmpfile
    echo "Command: $cmd" >> $tmpfile
    echo "Output:" >> $tmpfile
    if [ -z "$output" ]; then
        echo "No output received from the command." >> $tmpfile
    else
        echo "$output" >> $tmpfile
    fi

    # Get current pane ID
    local pane_id=$(tmux display-message -p '#{pane_id}')

    # Clear the buffer
    zle accept-line

    # Use tmux to send the command directly to the pane
    # This ensures proper TTY handling
    tmux send-keys -t "$pane_id" "KUBECONFIG=/home/decoder/dev/homelab/kubeconfig __claude_with_monitor.sh" C-m

    # Background task to send keys after claude starts
    (
        # Wait 2 seconds before first check (based on pairup.nvim:72)
        sleep 2

        # Wait for Claude CLI to be fully ready for input
        # Look for the bottom status line that shows the model and prompt is ready
        for i in {1..60}; do
            pane_content=$(tmux capture-pane -t "$pane_id" -p)
            # Check for "Sonnet" in status line - indicates full UI is rendered and ready
            if echo "$pane_content" | grep -q "Sonnet"; then
                # Found status line with model, wait 1 second to ensure fully ready
                sleep 1
                break
            fi
            sleep 0.1
        done

        # Send Ctrl+G to open Neovim buffer
        tmux send-keys -t "$pane_id" C-g

        # Wait for Neovim to actually open
        for i in {1..20}; do
            pane_content=$(tmux capture-pane -t "$pane_id" -p)
            if echo "$pane_content" | grep -qE "(nvim|INSERT|NORMAL|/tmp/)"; then
                break
            fi
            sleep 0.3
        done

        # Small wait for nvim to settle
        sleep 0.3

        # Go to command mode and read file
        tmux send-keys -t "$pane_id" Escape
        tmux send-keys -t "$pane_id" ":r $tmpfile" C-m

        # Delete the empty first line created by :r command
        tmux send-keys -t "$pane_id" "gg"
        tmux send-keys -t "$pane_id" "dd"

        # Search for "User request below:" and position cursor after it
        tmux send-keys -t "$pane_id" "/User request below:" C-m
        tmux send-keys -t "$pane_id" ":noh" C-m

        # Move to end of line and open 2 lines below
        tmux send-keys -t "$pane_id" "A"
        tmux send-keys -t "$pane_id" C-m
        tmux send-keys -t "$pane_id" C-m

        # Cleanup temp file
        command rm -f $tmpfile
    ) &>/dev/null &!
}

# Function to open Claude Code with Ctrl+G and template
function claude_prompt() {
    local current_path=$(pwd)

    # Create temporary file with just the instructions
    local tmpfile=$(mktemp /tmp/claude_prompt.XXXXXX)
    echo "$prompt_instructions" > $tmpfile
    echo "" >> $tmpfile

    # Get current pane ID
    local pane_id=$(tmux display-message -p '#{pane_id}')

    # Use tmux to send the command directly to the pane
    tmux send-keys -t "$pane_id" "KUBECONFIG=/home/decoder/dev/homelab/kubeconfig __claude_with_monitor.sh" C-m

    # Background task to send keys after claude starts
    (
        # Wait 2 seconds before first check (based on pairup.nvim:72)
        sleep 2

        # Wait for Claude CLI to be fully ready for input
        # Look for the bottom status line that shows the model and prompt is ready
        for i in {1..60}; do
            pane_content=$(tmux capture-pane -t "$pane_id" -p)
            # Check for "Sonnet" in status line - indicates full UI is rendered and ready
            if echo "$pane_content" | grep -q "Sonnet"; then
                # Found status line with model, wait 1 second to ensure fully ready
                sleep 1
                break
            fi
            sleep 0.1
        done

        # Send Ctrl+G to open Neovim buffer
        tmux send-keys -t "$pane_id" C-g

        # Wait for Neovim to actually open
        for i in {1..20}; do
            pane_content=$(tmux capture-pane -t "$pane_id" -p)
            if echo "$pane_content" | grep -qE "(nvim|INSERT|NORMAL|/tmp/)"; then
                break
            fi
            sleep 0.3
        done

        # Small wait for nvim to settle
        sleep 0.3

        # Go to command mode and read file
        tmux send-keys -t "$pane_id" Escape
        tmux send-keys -t "$pane_id" ":r $tmpfile" C-m

        # Delete the empty first line created by :r command
        tmux send-keys -t "$pane_id" "gg"
        tmux send-keys -t "$pane_id" "dd"

        # Search for "User request below:" and position cursor after it
        tmux send-keys -t "$pane_id" "/User request below:" C-m
        tmux send-keys -t "$pane_id" ":noh" C-m

        # Move to end of line and open 2 lines below
        tmux send-keys -t "$pane_id" "A"
        tmux send-keys -t "$pane_id" C-m
        tmux send-keys -t "$pane_id" C-m

        # Cleanup temp file
        command rm -f $tmpfile
    ) &>/dev/null &!
}

# Pick a claude command via fzf, insert on command line for editing
function claude_picker() {
    local cmd_dir="$HOME/.claude/commands"
    local selection
    selection=$(printf '%s\n' "$cmd_dir"/*.md \
        | xargs -I{} basename {} .md \
        | fzf --reverse --border --prompt="claude / " \
              --preview="bat --color=always --language=md --style=plain $cmd_dir/{}.md" \
              --preview-window=right:50%:wrap)
    [[ -z "$selection" ]] && { zle redisplay; return; }
    LBUFFER="__claude_with_monitor.sh -- \"/$selection "
    RBUFFER="\""
    zle redisplay
}

# Create widgets
zle -N execute_and_claude
zle -N claude_prompt
zle -N claude_picker

# Bind to Ctrl+Alt+G (replaces gpt binding)
bindkey '^[^G' execute_and_claude
bindkey '^[k' claude_picker

# Create 'gpt' alias for backward compatibility - now opens Claude Code
alias gpt='claude_prompt'

# Claude CLI power aliases
alias plaude='/home/decoder/.local/bin/claude --dangerously-skip-permissions -p'  # Print mode (direct binary)
alias flaude='claude -r --fork-session'           # Fork session with picker
alias dlaude='claude --debug "hooks,mcp"'         # Debug mode (hooks + mcp)
alias ccinstall='~/.claude/scripts/__claude_version_installer.sh'  # Version picker

# Work API keys from `pass work/`, billed per token instead of the subscription.
# Each command takes an optional leading -k NAME to use work/NAME instead of the
# default ANTHROPIC_SRE_AGENT_KEY. The key goes only to the child process (or the
# script's own --pass lookup), never into this shell's environment.

# Claude Code on a work key in the current dir: klaude [-k NAME] [claude args...]
# Launches through the same __claude_with_monitor.sh as the `claude` alias (kube
# isolation, monitor, account routing), called by path so no alias is needed.
# The key reaches Claude through an inline apiKeyHelper, not ANTHROPIC_API_KEY:
# interactive Claude Code checks an env key against customApiKeyResponses in
# .claude.json and silently falls back to the subscription when it was ever
# declined, while apiKeyHelper ranks above the /login subscription with no
# approval step. KLAUDE_KEY_NAME (the entry name, never the key) tells the
# statusline the session is on a work key.
function klaude() {
  local name=ANTHROPIC_SRE_AGENT_KEY
  if [[ "$1" == "-k" ]]; then
    [[ -n "$2" ]] || { echo "usage: klaude [-k NAME] [claude args...]" >&2; return 1; }
    name="$2"; shift 2
  fi
  [[ "$name" != *[^A-Za-z0-9_.-]* ]] || { echo "klaude: bad key name: $name" >&2; return 1; }
  pass show "work/$name" | head -1 | grep -q . || { echo "klaude: no key in pass work/$name" >&2; return 1; }
  env -u ANTHROPIC_API_KEY KLAUDE_KEY_NAME="$name" "$HOME/.claude/scripts/__claude_with_monitor.sh" \
    --settings "{\"apiKeyHelper\":\"pass show work/$name | head -1\"}" "$@"
}

# One dim line on stderr, the way classif prints its own: only at a terminal, so pipes
# and files stay clean. _k_dim PROG TEXT
function _k_dim() {
  [[ -t 2 && -n "$2" ]] && print -r -- $'\e[2m'"$1: $2"$'\e[0m' >&2
  return 0
}

# Model ids for `kapi -m <TAB>` and `kp -m <TAB>`, one id:display name per line, read only
# from the cache `kapi --refresh-models` writes (id<TAB>name<TAB>effort levels). A missing
# cache or one older than a day refreshes in the background, at most once per 10 minutes.
function _k_model_ids() {
  local cache="$HOME/.local/state/claude-runs/models.txt" line
  local -a fresh tried
  fresh=($cache(N.mh-24)) tried=($cache.try(N.mm-10))
  if (( ! ${#fresh} && ! ${#tried} )); then
    mkdir -p "${cache:h}" && : >"$cache.try"
    ( kapi --refresh-models </dev/null >/dev/null 2>&1 & )
  fi
  [[ -r "$cache" ]] || return 0
  for line in "${(@f)$(<"$cache")}"; do
    [[ -n "$line" ]] && print -r -- "${line%%$'\t'*}:${${line#*$'\t'}%%$'\t'*}"
  done
}

# The effort to send MODEL when WANT is asked: WANT unless the models cache lists the model
# without it, then the highest level at or below WANT it takes (empty: none) and one notice.
function _k_effort_for() {
  local model="$1" want="$2" cache="$HOME/.local/state/claude-runs/models.txt" line levels pick l
  local -a order=(low medium high xhigh max)
  [[ -n "$want" && -r "$cache" ]] || { print -r -- "$want"; return; }
  for line in "${(@f)$(<"$cache")}"; do
    [[ "${line%%$'\t'*}" == "$model" ]] && levels="${line##*$'\t'}"
  done
  if [[ -z "$levels" || "$levels" == "?" || ",$levels," == *",$want,"* ]]; then
    print -r -- "$want"; return
  fi
  for l in "${order[@]}"; do
    [[ ",$levels," == *",$l,"* ]] && pick="$l"
    [[ "$l" == "$want" ]] && break
  done
  if [[ -n "$pick" ]]; then
    echo "effort $want not accepted by $model; using $pick" >&2
  else
    echo "effort $want not accepted by $model; sending no effort" >&2
  fi
  print -r -- "$pick"
}

# One Messages API call on a work key (__claude_api_run.py, run with the anthropic SDK via uv):
#   kapi [-k NAME] -m MODEL [--effort LEVEL] [--prompt-file F] [--out F] [args...]   prompt on stdin otherwise
#   kapi [-k NAME] --refresh-models                                                    refresh the -m completion cache
# Effort defaults to xhigh; a model that rejects it runs at the highest level it accepts,
# with one notice. Prints the runner's JSON line, then a dim cost line at a terminal.
function kapi() {
  local name=ANTHROPIC_SRE_AGENT_KEY
  if [[ "$1" == "-k" ]]; then
    [[ -n "$2" ]] || { echo "usage: kapi [-k NAME] -m MODEL [args...]" >&2; return 1; }
    name="$2"; shift 2
  fi
  local -a py=(uv run --quiet --with anthropic python3 "$HOME/.claude/scripts/__claude_api_run.py" --pass "work/$name")
  if [[ "$1" == --refresh-models ]]; then
    "${py[@]}" --list-models </dev/null
    return
  fi
  local -a effort
  (( ${@[(I)--effort*]} )) || effort=(--effort xhigh)
  local record rc
  record=$("${py[@]}" "${effort[@]}" "$@"); rc=$?
  print -r -- "$record"
  _k_dim kapi "$(print -r -- "$record" | jq -r 'select(.input_tokens != null)
    | "in \(.input_tokens) out \(.output_tokens) cache read \(.cache_read_input_tokens) write \(.cache_creation_input_tokens), estimate $\(.usd_estimate // "?")"' 2>/dev/null)"
  return $rc
}

function _kapi() {
  local -a models
  if [[ "${words[CURRENT-1]}" == (-m|--model) ]]; then
    models=("${(@f)$(_k_model_ids)}")
    models=(${models:#})
    (( ${#models} )) && _describe 'model' models
  fi
}
(( $+functions[compdef] )) && compdef _kapi kapi

# Managed agents in the SRE workspace (__cma_adhoc.py, run with the anthropic SDK via uv).
#   kcma [-k NAME] --name SLUG [--out FILE] [args...]   ad hoc claude-adhoc-SLUG turn
#   kcma [-k NAME] [--keep] [AGENT] [prompt...]         run an existing agent
#   kcma [-k NAME] --session ID [prompt...]             follow-up turn in a session kept with --keep
#   kcma [-k NAME] --delete ID                          delete a kept session
# Without --name, AGENT (tab-completed from the cache --list writes) picks the agent, else
# fzf lists every agent with model and description; KCMA_PICK=AGENT skips fzf. The prompt
# is the remaining args, else stdin, else $EDITOR. The Console link prints when the session
# starts and the answer at the end. The session is deleted unless --keep; a kept session
# prints its delete command. Every run ends with a dim cost line at a terminal.
function kcma() {
  local name=ANTHROPIC_SRE_AGENT_KEY
  if [[ "$1" == "-k" ]]; then
    [[ -n "$2" ]] || { echo "usage: kcma [-k NAME] [--keep] [AGENT] [prompt...]" >&2; return 1; }
    name="$2"; shift 2
  fi
  local -a py=(uv run --quiet --with anthropic python3 "$HOME/.claude/scripts/__cma_adhoc.py" --pass "work/$name")
  local record rc
  if (( ${@[(Ie)--list]} || ${@[(Ie)--help]} )); then
    "${py[@]}" "$@"
    return
  fi
  if (( ${@[(Ie)--name]} || ${@[(Ie)--agent-id]} )); then
    record=$("${py[@]}" "$@"); rc=$?
    print -r -- "$record"
    _kcma_tail "$record"
    return $rc
  fi
  if [[ "$1" == --delete ]]; then
    [[ -n "$2" ]] || { echo "usage: kcma [-k NAME] --delete SESSION_ID" >&2; return 1; }
    record=$("${py[@]}" --delete-session "$2" </dev/null)
    if [[ "$(print -r -- "$record" | jq -r .deleted 2>/dev/null)" == true ]]; then
      echo "deleted $2"
    else
      print -r -- "$record" >&2
      return 1
    fi
    return
  fi
  local -a target keep
  local rows pick dir="$HOME/.local/state/claude-runs"
  if [[ "$1" == --session ]]; then
    [[ -n "$2" ]] || { echo "usage: kcma [-k NAME] --session SESSION_ID [prompt...]" >&2; return 1; }
    target=(--session-id "$2"); shift 2
  else
    [[ "$1" == "--keep" ]] && { keep=(--keep); shift; }
    rows=$("${py[@]}" --list </dev/null) || { echo "kcma: listing agents failed: $rows" >&2; return 1; }
    local want="${KCMA_PICK:-}"
    [[ -z "$want" && -n "$1" ]] && print -r -- "$rows" | jq -e --arg n "$1" 'select(.name == $n)' >/dev/null && { want="$1"; shift; }
    if [[ -n "$want" ]]; then
      pick=$(print -r -- "$rows" | jq -r --arg n "$want" 'select(.name == $n) | .id' | head -1)
      [[ -n "$pick" ]] || { echo "kcma: no agent named $want" >&2; return 1; }
    else
      command -v fzf >/dev/null || { echo "kcma: fzf is not installed" >&2; return 1; }
      pick=$(print -r -- "$rows" \
        | jq -r '[.id, .name, (.model // "?"), (.description // "")] | @tsv' \
        | fzf --reverse --border --delimiter=$'\t' --with-nth=2.. --prompt='kcma / ')
      pick="${pick%%$'\t'*}"
      [[ -n "$pick" ]] || return 1
    fi
    target=(--agent-id "$pick")
  fi
  local prompt="$*" tmp
  if [[ -z "$prompt" && ! -t 0 ]]; then
    prompt=$(command cat)
  elif [[ -z "$prompt" ]]; then
    tmp=$(mktemp "${TMPDIR:-/tmp}/kcma.XXXXXX.md")
    ${=EDITOR:-vi} "$tmp"
    prompt=$(<"$tmp"); command rm -f "$tmp"
  fi
  [[ -n "${prompt//[[:space:]]/}" ]] || { echo "kcma: empty prompt" >&2; return 1; }
  mkdir -p "$dir"
  local out="$dir/kcma-$(date +%Y%m%d-%H%M%S)-$$.md"
  record=$("${py[@]}" "${target[@]}" "${keep[@]}" --out "$out" <<<"$prompt")
  if [[ -s "$out" ]]; then
    command cat "$out"
  else
    print -r -- "$record" >&2
  fi
  _kcma_tail "$record"
  [[ "$(print -r -- "$record" | jq -r .status 2>/dev/null)" == ok ]]
}

# After a kcma run: the delete command for a kept session, then the dim cost line.
function _kcma_tail() {
  local sid
  sid=$(print -r -- "$1" | jq -r 'select(.deleted == false and .session_id != null) | .session_id' 2>/dev/null)
  [[ -n "$sid" ]] && echo "session $sid kept; follow up: kcma --session $sid \"...\"; delete: kcma --delete $sid" >&2
  _k_dim kcma "$(print -r -- "$1" | jq -r '.cost_line // empty' 2>/dev/null)"
}

# Cached agent names for `kcma <TAB>`, one name:description per line; never calls the API.
function _kcma_agent_names() {
  local cache="$HOME/.local/state/claude-runs/cma_agents.txt"
  [[ -r "$cache" ]] && print -rl -- "${(@f)$(<"$cache")}"
}

function _kcma() {
  local -a agents
  agents=("${(@f)$(_kcma_agent_names)}")
  if (( CURRENT == 2 )) || { (( CURRENT == 3 )) && [[ "${words[2]}" == --keep ]]; }; then
    (( ${#agents} )) && [[ -n "${agents[1]}" ]] && _describe 'managed agent' agents
  fi
}
(( $+functions[compdef] )) && compdef _kcma kcma

# Run a whole Claude Code session as one of the local agents in ~/.claude/agents (the work
# home links the same folder), through the usual launcher:
#   ca [AGENT] [claude args or prompt...]
# The agent's prompt replaces the default system prompt and its tools, model and effort
# apply, so a lookup session costs less than a full `c` session. AGENT tab-completes with
# model/effort and description; without it fzf lists every agent; CA_PICK=AGENT skips fzf.
# A first word that is no agent stays in the arguments, as in kcma.
function ca() {
  local rows want="${CA_PICK:-}" pick
  rows=$(_ca_rows)
  [[ -n "$rows" ]] || { echo "ca: no agent definitions in ${CLAUDE_AGENTS_DIR:-$HOME/.claude/agents}" >&2; return 1; }
  if [[ -z "$want" && -n "$1" ]] && _ca_known "$rows" "$1"; then
    want="$1"; shift
  fi
  if [[ -n "$want" ]]; then
    _ca_known "$rows" "$want" || { echo "ca: no agent named $want" >&2; return 1; }
    pick="$want"
  else
    command -v fzf >/dev/null || { echo "ca: fzf is not installed" >&2; return 1; }
    pick=$(print -r -- "$rows" | fzf --reverse --border --delimiter=$'\t' --tabstop=4 --prompt='ca / ')
    pick="${pick%%$'\t'*}"
    [[ -n "$pick" ]] || return 1
  fi
  "$HOME/.claude/scripts/__claude_with_monitor.sh" --agent "$pick" "$@"
}

# True when ROWS (from _ca_rows) has an agent named NAME.
function _ca_known() {
  print -r -- "$1" | awk -F'\t' -v n="$2" '$1 == n { found = 1 } END { exit !found }'
}

# One row per agent file: name, model, effort and description, tab-separated, read from the
# frontmatter. A folded description (description: >-) joins its lines; a missing model reads
# inherit, a missing effort -, and a file without frontmatter is listed by its file name.
function _ca_rows() {
  local f
  for f in "${CLAUDE_AGENTS_DIR:-$HOME/.claude/agents}"/*.md(N); do
    awk -v file="${f:t:r}" '
      NR == 1 && $0 != "---" { exit }
      NR > 1 && $0 == "---" { exit }
      fold && /^[ \t]+[^ \t]/ { sub(/^[ \t]+/, ""); desc = desc (desc == "" ? "" : " ") $0; next }
      { fold = 0 }
      /^name:/ { name = $0; sub(/^name:[ \t]*/, "", name) }
      /^model:/ { model = $0; sub(/^model:[ \t]*/, "", model) }
      /^effort:/ { effort = $0; sub(/^effort:[ \t]*/, "", effort) }
      /^description:/ {
        desc = $0; sub(/^description:[ \t]*/, "", desc)
        if (desc ~ /^[>|]-?$/) { fold = 1; desc = "" }
      }
      END {
        if (desc ~ /^".*"$/ || desc ~ /^\047.*\047$/) desc = substr(desc, 2, length(desc) - 2)
        printf "%s\t%s\t%s\t%s\n", (name == "" ? file : name), (model == "" ? "inherit" : model),
          (effort == "" ? "-" : effort), desc
      }
    ' "$f"
  done
}

# `name:model/effort  description` lines for _describe, descriptions cut to 90 chars.
function _ca_completions() {
  _ca_rows | awk -F'\t' '{ d = $4; if (length(d) > 90) d = substr(d, 1, 89) "…"; printf "%s:%s/%s  %s\n", $1, $2, $3, d }'
}

function _ca() {
  (( CURRENT == 2 )) || return 1
  local -a agents
  agents=("${(@f)$(_ca_completions)}")
  (( ${#agents} )) && [[ -n "${agents[1]}" ]] && _describe 'agent' agents
}
(( $+functions[compdef] )) && compdef _ca ca

# Headless one-shot Claude Code in the current dir on a work key, read-only tools by default:
#   kp [-k NAME] [-m MODEL] [-e EFFORT] [-t TOOLS] "prompt"   (prompt on stdin otherwise)
# Effort defaults to xhigh; a model the models cache lists without it runs at the highest
# level it takes, with one notice. Prints the session line first, then the answer, then a
# dim cost line at a terminal. The prompt, result JSON and stderr land in
# ~/.local/state/claude-runs/kp-*.
function kp() {
  local usage='usage: kp [-k NAME] [-m MODEL] [-e EFFORT] [-t TOOLS] "prompt"'
  local key=ANTHROPIC_SRE_AGENT_KEY model=sonnet effort=xhigh
  local tools='Read,Grep,Glob,Bash(rg:*),Bash(fd:*),Bash(ls:*),Bash(sed:*)'
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -k|-m|-e|-t)
        [[ -n "$2" ]] || { echo "$usage" >&2; return 1; }
        case "$1" in -k) key="$2" ;; -m) model="$2" ;; -e) effort="$2" ;; -t) tools="$2" ;; esac
        shift 2 ;;
      --) shift; break ;;
      -*) echo "$usage" >&2; return 1 ;;
      *) break ;;
    esac
  done
  local prompt="$*"
  [[ -z "$prompt" && ! -t 0 ]] && prompt=$(command cat)
  [[ -n "${prompt//[[:space:]]/}" ]] || { echo "$usage" >&2; return 1; }
  effort=$(_k_effort_for "$model" "$effort")
  local dir="$HOME/.local/state/claude-runs"
  local base="$dir/kp-$(date +%Y%m%d-%H%M%S)-$$" line summary
  mkdir -p "$dir"
  print -r -- "$prompt" >"$base.prompt"
  "$HOME/.claude/scripts/__claude_headless_run.sh" --key "$key" --model "$model" --effort "$effort" \
    --allowed-tools "$tools" --cwd "$PWD" --prompt-file "$base.prompt" --out "$base.json" \
    | { IFS= read -r line && print -r -- "$line"; summary=$(command cat) }
  local rc=${pipestatus[1]}
  jq -r '.result // empty' "$base.json" 2>/dev/null
  _k_dim kp "$(print -r -- "$summary" | jq -r '"cost $\(.total_cost_usd // "?") turns \(.num_turns // "?") \(((.duration_ms // 0) / 1000) | floor)s \(.subtype // "error")"' 2>/dev/null \
    || print -r -- "$summary")"
  return $rc
}

function _kp() {
  local -a models
  if [[ "${words[CURRENT-1]}" == -m ]]; then
    models=('haiku:Claude Code alias' 'sonnet:Claude Code alias' 'opus:Claude Code alias'
      'fable:Claude Code alias' "${(@f)$(_k_model_ids)}")
    models=(${models:#})
    _describe 'model' models
  fi
}
(( $+functions[compdef] )) && compdef _kp kp

# Run interactive Codex sessions through its managed Unix-socket app-server.
# The agents MCP server can then deliver inbound DMs to the active Codex thread
# with turn/start or turn/steer, providing the push path Codex lacks in MCP.
alias codex="$HOME/.codex/scripts/__codex_with_app_server.sh"
alias cx='codex'
alias cxr='codex resume'
alias cxra='codex resume --all'
alias cxf='codex fork'
alias cxsync='$HOME/.codex/scripts/__codex_sync.sh'

# Pick a Codex skill and insert a new interactive command for editing.
function codex_skill_picker() {
  local skills_dir="${CODEX_HOME:-$HOME/.codex}/skills"
  local record selection
  record=$(fd -H -I -L -t f -d 3 '^SKILL\.md$' "$skills_dir" 2>/dev/null \
    | while read -r skill_file; do
        printf '%s\t%s\n' "${skill_file:h:t}" "$skill_file"
      done \
    | sort -u \
    | fzf --reverse --border --delimiter=$'\t' --with-nth=1 --prompt='codex $ ' \
      --preview='bat --color=always --language=md --style=plain {2}' \
      --preview-window=right:55%:wrap)
  selection="${record%%$'\t'*}"
  [[ -n "$selection" ]] || { zle redisplay; return; }
  LBUFFER="codex \"\$$selection "
  RBUFFER='"'
  zle redisplay
}
zle -N codex_skill_picker
bindkey '^[K' codex_skill_picker

# Per-account Claude config routing (#91)
#
# Interactive entry points use __claude_with_monitor.sh for account routing and
# agents-bus channels. Print-mode `plaude` still calls the binary directly. Setting
# CLAUDE_CONFIG_DIR from the current directory on every `cd` makes EVERY entry
# point inherit the correct account, so a `plaude` run inside ~/loft uses the work
# login and one anywhere else uses personal, with no manual switch.
#
# Reuses the single source of truth (claude_work_predicate) the launcher and
# picker use, so the shell and launcher can never disagree about what is "work".
# A non-work dir explicitly unsets the var, so an inherited value can never leak
# work routing into a personal directory.
if [[ -f "$HOME/.claude/scripts/__lib_claude_account.sh" ]]; then
  source "$HOME/.claude/scripts/__lib_claude_account.sh"
  _claude_account_route() {
    if [[ -d "$HOME/.claude-work" ]] && claude_work_predicate "$PWD"; then
      export CLAUDE_CONFIG_DIR="$HOME/.claude-work"
      # Codex offload auth/config splits the same way (see __claude_with_monitor.sh):
      # a work cwd points $CODEX_HOME at the work login, everything else uses the
      # default ~/.codex. Also routes the plain `codex` CLI, not just the MCP server.
      export CODEX_HOME="$HOME/.codex-work"
    else
      unset CLAUDE_CONFIG_DIR
      unset CODEX_HOME
    fi
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook chpwd _claude_account_route
  _claude_account_route   # initialize for the shell's starting directory
fi
