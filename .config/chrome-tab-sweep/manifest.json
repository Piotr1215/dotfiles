{
  "manifest_version": 3,
  "name": "Tab sweep",
  "version": "1.0.0",
  "description": "Close tabs of merged GitHub PRs and exact duplicate URLs, and report them to Gordon.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "storage"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Tab sweep", "default_popup": "popup.html"},
  "commands": {"_execute_action": {"description": "Open Tab sweep"}}
}
