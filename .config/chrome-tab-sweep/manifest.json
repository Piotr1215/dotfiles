{
  "manifest_version": 3,
  "name": "Tab sweep",
  "version": "1.3.0",
  "description": "Close tabs of merged GitHub PRs and exact duplicate URLs, and report them to Gordon.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab sweep",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "description": "Open Tab sweep"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
