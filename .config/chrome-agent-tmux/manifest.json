{
  "manifest_version": 3,
  "name": "Agent tab tmux switch",
  "version": "1.0.0",
  "description": "Switch to an agent session when its Chrome tab is activated.",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage",
    "management"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
