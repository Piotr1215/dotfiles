# Launch rc for the handoffs report (__cycle_tui_reports.sh passes it with --taskrc).
# context.work.read is `+work -gordon -piotr`, and a report filter cannot lift a
# context, so this rc drops the context. The report filter (+piotr) does the rest.
include ~/.taskrc
context=none
# Open without the detail pane; z toggles it when needed.
uda.taskwarrior-tui.task-report.show-info=false
