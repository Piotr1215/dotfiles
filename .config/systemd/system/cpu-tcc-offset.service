# Set package PL1 to 160 W and TCC offset to 13, the firmware default of 92C
# with TjMax 105C. Piotr wants to "remove any artificial blockages on the chip":
# "I have good cooling and I need as much power as I can get" (26 Nov 2026).
# Firmware set PL1 to 44 W on both RAPL interfaces, below Intel's 55 W base
# power; PL2 was 160 W and MSR 0x610 lock bit 63 was 0. Under agent load, the
# package averaged 44.0 W, with 88% of 2-second samples at 42 W or more.
# After setting PL1 to 160 W and offset to 13 at 10:07, cores averaged 4364 MHz
# versus 3674 MHz before; package power averaged 60 W, peaked at 77 W, and
# temperature peaked at 92C.
# Install from the dotfiles root:
# sudo install -m644 .config/systemd/system/cpu-tcc-offset.service /etc/systemd/system/
# sudo systemctl daemon-reload
# sudo systemctl reenable cpu-tcc-offset.service
[Unit]
Description=Run serval's CPU at full power: PL1 160 W, thermal target 92C (TCC offset 13)
After=systemd-modules-load.service suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
RemainAfterExit=no
Environment=TCC_OFFSET=13
Environment=PL1_UW=160000000
# The processor thermal driver can probe after this starts; retry for 30 s.
ExecStart=/bin/sh -c 'status=0; tcc_set=0; \
    for _ in $$(seq 30); do \
        for f in /sys/bus/pci/drivers/proc_thermal_pci/*/tcc_offset_degree_celsius; do \
            if [ -w "$$f" ] && echo "$$TCC_OFFSET" > "$$f"; then \
                echo "tcc offset $$(cat "$$f") via $$f"; tcc_set=1; break 2; \
            fi; \
        done; \
        sleep 1; \
    done; \
    if [ "$$tcc_set" -ne 1 ]; then echo "no writable tcc_offset_degree_celsius" >&2; status=1; fi; \
    found=0; \
    for zone in /sys/class/powercap/intel-rapl:* /sys/class/powercap/intel-rapl-mmio:*; do \
        [ -r "$$zone/name" ] || continue; \
        [ "$$(cat "$$zone/name")" = package-0 ] || continue; \
        found=1; \
        if [ ! -r "$$zone/constraint_0_name" ] || [ "$$(cat "$$zone/constraint_0_name")" != long_term ]; then \
            echo "missing or unexpected constraint 0 on $$zone" >&2; status=1; continue; \
        fi; \
        if echo "$$PL1_UW" > "$$zone/constraint_0_power_limit_uw"; then \
            echo "pl1 $$(cat "$$zone/constraint_0_power_limit_uw") via $$zone"; \
        else \
            status=1; \
        fi; \
    done; \
    if [ "$$found" -eq 0 ]; then echo "no package-0 RAPL zone" >&2; status=1; fi; \
    exit "$$status"'

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
