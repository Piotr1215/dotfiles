[Unit]
Description=Real-time NVMe mirror of work-in-progress files
# Keep running across unmounts so reconnect can trigger catch-up.
After=local-fs.target
# Start before logins and stop after every user session, so a clean-stop list
# written at shutdown misses no save and the next boot can skip the full scan.
Before=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -EsB /usr/local/lib/wip-mirror/__wip_mirror.py
Restart=on-failure
RestartSec=10s
Nice=10
# Gordon and its subagents need the CPU at boot (Piotr, 21 Nov). An idle
# weight runs the daemon only on CPU nothing else wants. No quota: a quota
# also throttled the event reader and overflowed the kernel queue.
CPUWeight=idle
IOSchedulingClass=idle
# /var/lib/wip-mirror holds the clean-stop list; the root filesystem outlives
# the nofail drive at shutdown.
StateDirectory=wip-mirror
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
