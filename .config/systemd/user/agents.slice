[Unit]
Description=Agent sessions (Claude, Codex) and everything they spawn

[Slice]
# Caps the whole agent fleet so a burst of sessions, subagents, npm ci and tool
# commands cannot starve the desktop. 24 cores: 1800% leaves 6 for the rest.
CPUQuota=1800%
MemoryHigh=60G
MemoryMax=72G
TasksMax=8192
