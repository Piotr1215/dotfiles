[Unit]
Description=Voice mode (spoken lines to named agents)
Documentation=file:%h/dev/dotfiles/scripts/__voice_mode.py
After=pipewire-pulse.service
# Written by the voice-mode toggle, so a reboot keeps it off.
ConditionPathExists=!%h/.local/state/klod-voice/no-listening

[Service]
Type=simple
ExecStart=%h/dev/dotfiles/scripts/__voice_mode.py
Restart=on-failure
RestartSec=3
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
