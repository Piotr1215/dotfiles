[Unit]
Description=Voice mode (headset speech to named agent panes)
Documentation=file:%h/dev/dotfiles/scripts/__voice_mode.py
After=pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/dev/dotfiles/scripts/__voice_mode.py
Restart=on-failure
RestartSec=3
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
