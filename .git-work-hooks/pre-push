#!/bin/bash

echo "Hook running from: $0" >&2
echo "Current directory: $(pwd)" >&2

protected_branches=('main' 'master')
current_branch=$(git symbolic-ref HEAD | sed -e 's,.*/\(.*\),\1,')

echo "Current branch: $current_branch" >&2
echo "Protected branches: ${protected_branches[*]}" >&2

# Git provides: <local ref> <local sha> <remote ref> <remote sha>.
# Check every destination and retain whether all pushed refs already exist.
has_push_refs=false
existing_remote_refs=true
while read -r _ _ remote_ref remote_sha; do
    has_push_refs=true
    for protected_branch in "${protected_branches[@]}"; do
        if [[ "$remote_ref" == "refs/heads/$protected_branch" ]]; then
            echo "🚫 Blocking push to protected branch: $protected_branch" >&2
            exit 1
        fi
    done

    if [[ -z "$remote_ref" || ! "$remote_sha" =~ ^[0-9a-fA-F]+$ || "$remote_sha" =~ ^0+$ ]]; then
        existing_remote_refs=false
    fi
done

full_branch=$(git symbolic-ref --short HEAD)
branch_suffix="${full_branch##*/}"

if [[ "$branch_suffix" =~ ^[0-9_-]+$ ]]; then
    if [[ "$has_push_refs" != true || "$existing_remote_refs" != true ]]; then
        echo "🚫 Branch has auto-generated slug: $full_branch" >&2
        echo "   Suffix '$branch_suffix' contains no letters - likely auto-generated" >&2
        echo "   Rename to something meaningful:" >&2
        echo "   git branch -m $full_branch ${full_branch%/*}/descriptive-slug" >&2
        exit 1
    fi
fi

echo "✅ Push allowed" >&2
exit 0
