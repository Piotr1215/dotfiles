# Define the abbreviation
typeset -A abbrevs
abbrevs=(
    # The "# description" comment on each line is what the ;;abbr picker shows.
    ";;abbr" '__abbrev_picker'      # pick an abbreviation in fzf
    "_last" '__last_arg_expand'     # last arg of the previous command
    "_spo" '__sponge_expand'        # pipe into sponge on the last arg
    "_bak" '__backup_expand'        # cp -a the last arg to a dated .bak
    "_ind" '__into_new_dir'         # mkdir -p the last arg first
    "_xrg" '__xargs_expand'         # turn the last word into xargs -I {}
    "_chmo" '__chmod_file'          # chmod +x a file picked in fzf
    "?rep" '__global_replace'       # rerun last command with :gs/NAME/
    "?fil" '__file_replace'         # replace NAME with a picked file
    "?filt" '__temp_file_replace'   # replace NAME with a picked /tmp file
    "_pad" '__pueue_add_expand'     # wrap the line in pueue add
    "_jq" '__jq_expand'             # pipe output through jq
    "_br" '__branch_expand'         # insert the current git branch
    "_dup" '__duplicate_expand'      # duplicate the last argument
    "_sub" '__substitute_expand'    # wrap the line in command substitution
    "_for" '__for_expand'           # loop over selected arguments
)

# Add a jq filter and put the cursor before its initial dot.
__jq_expand() {
    local cmd=${LBUFFER% }
    [[ -n $cmd ]] || return 1
    local -a words=("${(z)cmd}")
    if [[ $cmd == curl(|[[:space:]]*) ]]; then
        local word silent=0
        for word in "${words[@]:1}"; do
            [[ $word == '|' || $word == ';' || $word == '&&' || $word == '||' ]] && break
            [[ $word == --silent || $word == -[^-]#s[^-]# ]] && silent=1
        done
        (( silent )) || cmd="curl -s${cmd#curl}"
    fi
    LBUFFER="$cmd | jq -r '"
    RBUFFER=".'$RBUFFER"
}

# Insert a quoted symbolic branch name, leaving the trigger on failure.
__branch_expand() {
    local branch
    branch=$(command git symbolic-ref --quiet --short HEAD 2>/dev/null) || return 1
    [[ -n $branch ]] || return 1
    LBUFFER+=${(q)branch}
}

# Duplicate the last shell word without evaluating it.
__duplicate_expand() {
    local cmd=${LBUFFER% }
    local -a words=("${(z)cmd}")
    (( ${#words} >= 2 )) || return 1
    [[ ${words[-1]} == [0-9]#(\<|\>)* || ${words[-1]} == (\||\|\||\&|\&\&|\;) ]] && return 1
    LBUFFER="$cmd ${words[-1]}"
}

# Wrap the existing line and leave the cursor before the substitution.
__substitute_expand() {
    local cmd=${LBUFFER% }
    [[ -n $cmd ]] || return 1
    LBUFFER=''
    RBUFFER=" \$($cmd)$RBUFFER"
}

# Offer each possible split between a simple command and its arguments.
__for_expand() {
    local cmd=${LBUFFER% } word row choice
    local -a words=("${(z)cmd}") rows
    (( ${#words} >= 2 )) || return 1
    for word in "${words[@]}"; do
        [[ $word == [0-9]#(\<|\>)* || $word == (\||\|\||\&|\&\&|\;|\;\;|\|\&) || $word == *$'\n'* ]] && return 1
    done
    local i
    for (( i = 1; i < ${#words}; i++ )); do
        rows+=("$i"$'\t'"${(j: :)words[1,i]} | ${(j: :)words[i+1,-1]}")
    done
    if (( ${#rows} == 1 )); then
        choice=1
    else
        row=$(printf '%s\n' "${rows[@]}" | fzf --delimiter=$'\t' --with-nth=2.. --prompt='split> ') || return 1
        choice=${row%%$'\t'*}
        [[ $choice == <-> ]] && (( choice >= 1 && choice <= ${#rows} )) || return 1
    fi
    LBUFFER="for x in ${(j: :)words[choice+1,-1]}; do ${(j: :)words[1,choice]} \"\$x\"; done"
}

# Pick an abbreviation in fzf and insert its trigger (space then expands it).
# Ctrl-E opens this file at the picked entry and reloads it on exit.
__abbrev_picker() {
    local src=~/.zsh_abbreviations out key sel trigger line
    out=$(awk -F'#' '
        /^abbrevs=\(/ { on=1; next }
        on && /^\)/   { exit }
        on && match($1, /"[^"]+"/) {
            t=substr($1, RSTART+1, RLENGTH-2); d=$2; sub(/^[ \t]+/,"",d)
            if (t != ";;abbr") printf "%-7s %s\n", t, d
        }' "$src" | fzf --height 40% --reverse --prompt 'abbr> ' --tiebreak=index \
            --expect=ctrl-e --header 'enter: insert · ctrl-e: edit source')
    key=${out%%$'\n'*}
    sel=${${out#*$'\n'}%% *}
    if [[ "$key" == ctrl-e ]]; then
        line=$(grep -nF "\"$sel\"" "$src" | head -1 | cut -d: -f1)
        ${EDITOR:-nvim} +${line:-1} "$src" </dev/tty
        source "$src"
    elif [[ -n "$sel" ]]; then
        LBUFFER+="$sel"
    fi
    zle reset-prompt
}

# Insert the last word of the previous command (like Alt+.)
__last_arg_expand() {
    local prev=$(fc -ln -1)
    local words=("${(z)prev}")
    LBUFFER+="${words[-1]}"
}

__pueue_add_expand() {
    # Remove the _pad trigger and any trailing space
    local cmd="${LBUFFER% _pad}"
    # Trim any trailing whitespace from cmd
    cmd="${cmd%% }"
    # Escape any double quotes in the command
    cmd="${cmd//\"/\\\"}"
    # Set the buffer but don't execute
    LBUFFER="pueue add \"FORCE_COLOR=1 $cmd\""
    # Don't call zle accept-line - just leave it for user to review/edit
}

__xargs_expand() {
    local cmd="$LBUFFER"
    local words=("${(z)cmd}")
    local xargs_cmd="${words[-1]}" 
    cmd=${cmd% * *}
    LBUFFER="$cmd | xargs -I {} $xargs_cmd {}"
}

__into_new_dir() {
    local cmd="$LBUFFER"
    local words=("${(z)cmd}")
    local last_arg="${words[-1]}"
    # Get everything before the directory name and 'ind'
    cmd=${cmd%% $last_arg ind}
    # Remove any trailing spaces
    cmd=${cmd%%[[:space:]]}
    LBUFFER="mkdir -p $last_arg && $cmd"
}

# Function to expand the sponge command
__chmod_file() {
    local cmd="$LBUFFER"
    selected_file=$(fd --type f | fzf --height 40% --reverse)
    LBUFFER="chmod +x $selected_file"
    zle accept-line
}

# Function to expand global replacement pattern  
__global_replace() {
    local cmd="$LBUFFER"
    # Remove the ?rep trigger and the trailing space before ?
    cmd=${cmd%% ?rep}
    # Remove the trailing space and ? from pet snippet
    cmd=${cmd% \?}
    # For global replace, we need to save the command first then replace
    # Using print -s to add to history, then recall with substitution
    print -s "$cmd"
    LBUFFER="!!:gs/NAME/"
}

# Function to replace NAME with file selection via fzf
__file_replace() {
    local cmd="$LBUFFER"
    # Remove the ?fil trigger and the trailing space before ?
    cmd=${cmd%% ?fil}
    # Remove the trailing space and ? from pet snippet
    cmd=${cmd% \?}
    
    # First, select the file
    local replacement=$(fd -t f -d 3 . 2>/dev/null | fzf --prompt="Select file: ")
    
    # If user cancelled (ESC), restore original command
    if [[ -z "$replacement" ]]; then
        LBUFFER="$cmd ?"
        return
    fi
    
    # Now check if there's NAME in the command
    if [[ "$cmd" == *NAME* ]]; then
        # Replace NAME with the selected file
        LBUFFER="${cmd//NAME/$replacement}"
    else
        # No NAME, so set up history substitution with the file as replacement
        # Add command to history
        print -s "$cmd"
        # Escape slashes in the replacement path for sed-style substitution
        local escaped_replacement="${replacement//\//\\/}"
        # Create the substitution command with empty search pattern
        # User needs to fill in what to search for
        LBUFFER="!!:gs//$escaped_replacement/"
        # Position cursor right after the first / so user can type what to replace
        local prefix="!!:gs/"
        CURSOR=${#prefix}
    fi
}

# Function to replace NAME with temp file selection via fzf
__temp_file_replace() {
    local cmd="$LBUFFER"
    # Remove the ?filt trigger and the trailing space before ?
    cmd=${cmd%% ?filt}
    # Remove the trailing space and ? from pet snippet
    cmd=${cmd% \?}
    
    # First, select the file from /tmp directory
    local replacement=$(fd -t f . /tmp 2>/dev/null | fzf --prompt="Select temp file: ")
    
    # If user cancelled (ESC), restore original command
    if [[ -z "$replacement" ]]; then
        LBUFFER="$cmd ?"
        return
    fi
    
    # Now check if there's NAME in the command
    if [[ "$cmd" == *NAME* ]]; then
        # Replace NAME with the selected file
        LBUFFER="${cmd//NAME/$replacement}"
    else
        # No NAME, so set up history substitution with the file as replacement
        # Add command to history
        print -s "$cmd"
        # Escape slashes in the replacement path for sed-style substitution
        local escaped_replacement="${replacement//\//\\/}"
        # Create the substitution command with empty search pattern
        # User needs to fill in what to search for
        LBUFFER="!!:gs//$escaped_replacement/"
        # Position cursor right after the first / so user can type what to replace
        local prefix="!!:gs/"
        CURSOR=${#prefix}
    fi
}

# Function to expand the sponge command
__sponge_expand() {
    local cmd="$LBUFFER"
    local words=("${(z)cmd}")  # Split command into words
    local last_arg="${words[-1]}"
    LBUFFER="$cmd | sponge $last_arg"
}

# Fixed version
__backup_expand() {
    local cmd="$LBUFFER"
    # Remove 'bak' from the end of the command
    cmd=${cmd%% bak}
    local words=("${(z)cmd}")
    local last_arg="${words[-1]}"
    LBUFFER="cp -a $last_arg{,.bak-$(date +%Y%m%d-%H%M)}"
}

expand-abbrev() {
    local MATCH
    LBUFFER=${LBUFFER%%(#m)[?;_a-zA-Z0-9]#}
    if [[ -n "${abbrevs[$MATCH]}" ]]; then
        if ! ${abbrevs[$MATCH]}; then
            LBUFFER+=$MATCH
            return
        fi
        # Keep the cursor in place for rewrites that need further editing.
        if [[ "$MATCH" != "?rep" && "$MATCH" != "?fil" && "$MATCH" != "?filt" && "$MATCH" != ";;abbr" && "$MATCH" != "_jq" && "$MATCH" != "_dup" && "$MATCH" != "_sub" && "$MATCH" != "_for" ]]; then
            zle self-insert
        fi
    else
        LBUFFER+=$MATCH
        zle self-insert
    fi
}

# Create the wdget and bind it
zle -N expand-abbrev
bindkey " " expand-abbrev
bindkey -M isearch " " self-insert

