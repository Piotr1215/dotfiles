#compdef snd

# Completion for snd, the agents comms bus publisher.
#
# Names and groups come from the live presence stream via
# __agents_presence.sh, which agents-presence.service keeps current. The
# previous version of this file completed from the `agents` table in
# agents.duckdb and advertised nine flags snd no longer parses; both went stale
# when agents-mcp-server dropped DuckDB for an in-memory registry plus NATS
# presence, and TAB kept serving months-dead groups.

_snd_roster() {
    local helper="${AGENTS_PRESENCE_HELPER:-$HOME/dev/dotfiles/scripts/__agents_presence.sh}"
    [[ -x "$helper" ]] || return 1
    "$helper" "$1" 2>/dev/null
}

_snd_agents() {
    local -a agents
    agents=(${(f)"$(_snd_roster --agents)"})
    (( ${#agents} )) && _describe -t agents 'live agents' agents
}

_snd_groups() {
    local -a groups
    groups=(${(f)"$(_snd_roster --groups)"})
    (( ${#groups} )) && _describe -t groups 'live groups' groups
}

_arguments -s \
    '(-t -g 1)-t[DM to an agent]:agent:_snd_agents' \
    '(-t -g 1)-g[Broadcast to a group]:group:_snd_groups' \
    '(--no-human)--human[Prefix the payload with the HUMAN marker]' \
    '(--human)--no-human[Publish without the HUMAN marker]' \
    '(- *)--tail[Watch every bus event, read-only]' \
    '(- *)'{-h,--help}'[Show usage]' \
    '1:agent:_snd_agents' \
    '*:message:'
